{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ai-review/server",
        "dev"
      ],
      "port": 4100
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ai-review/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_MOCK=1",
        "pnpm",
        "--filter",
        "@ai-review/web",
        "exec",
        "vite",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
