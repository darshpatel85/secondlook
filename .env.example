# GitHub personal access token with repo read and pull-request write (used for API calls and git clone/fetch)
GITHUB_TOKEN=

# Optional overrides
PORT=4100
# Web app port; the web app proxies /api to PORT
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
# Landing page port
LANDING_PORT=5175
AI_REVIEW_MODEL=opus

# Where the optional integrations file lives (defaults to integrations.json at the workspace root)
# AI_REVIEW_INTEGRATIONS=/absolute/path/to/integrations.json
